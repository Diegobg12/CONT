# Copia este archivo a .env y llena los valores. Nunca subas .env a git.
DEMO_MODE=true
DRY_RUN=true

ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-5-5
CONFIDENCE_THRESHOLD=0.80

SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=

# Opcionales del modo demo
# DEMO_DELAY_FACTOR=1.0      # 0 = instantáneo, 1 = tiempos realistas
# DEMO_SIMULAR_PAUSA=false   # true = simula que la DIAN pide verificación humana
